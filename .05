local HiddenUI = CoreGui:FindFirstChild("HiddenUI") or Instance.new("Folder", CoreGui)
HiddenUI.Name = "HiddenUI"
HiddenUI.Parent = CoreGui



local GuiName = "UI_" .. tostring(math.random(1000,9999))
local ScreenGui = Instance.new("ScreenGui", HiddenUI)
ScreenGui.Enabled = true

ScreenGui.Name = GuiName
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
ScreenGui.IgnoreGuiInset = true

